@model List<Lembrete>

<h1>@ViewData["Title"]</h1>

<script>

        $(document).ready(function(){
        $('.checkbox-lembrete').change(function(){
             var idSelecionado = parseInt($(this).val());
             var marcado = $(this).is(':checked');
             if(marcado == true){
                 console.log(idSelecionado);
                 ConcluirLembrete(idSelecionado);
             }
        });
    });

    function ConcluirLembrete(idSelecionado){
        $.ajax({
            url: '/Estacionamento/ConcluirLembrete',
            type: 'POST',
            data: { id: idSelecionado },
            success: function (response) {
                console.log('Resposta do servidor:', response);
                alert('Deu certo!');
                $('#partialView_Lembretes').load(`/Estacionamento/PartialLembretes`);
            },
            error: function (error) {
                console.error('Erro na solicitação:', error);
            }
        });
    }

    function AdicionarLembrete() {
        let lembrete = $('#txtLembrete').val();
        console.log(lembrete);
        $.ajax({
            url: '/Estacionamento/RegistrarLembrete',
            type: 'POST',
            data: { lembrete: lembrete },
            success: function (response) {
                console.log('Resposta do servidor:', response);
                alert('Deu certo!');
                $('#btnFecharModalLembrete').click();
                $('#partialView_Lembretes').load(`/Estacionamento/PartialLembretes`);
            },
            error: function (error) {
                console.error('Erro na solicitação:', error);
            }
        });
    }

</script>


<ul>
    @{
        if (Model != null && Model.Count > 0)
        {
            <span>@Model.Count Lembretes</span>
            foreach(Lembrete item in Model)
            {  
                <li class="list-group-item">
                    <input class="form-check-input me-1 checkbox-lembrete" type="checkbox" value="@item.Id" aria-label="...">
                    @item.Descricao
                </li>
            }
            <li class="list-group-item">
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modelDialogAdicionarLembrete" data-bs-whatever="mdo">Adicionar lembrete</button>
            </li>
            
        }
        else
        {
            <p>Você ainda não adicionou nenhum lembrete!</p>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modelDialogAdicionarLembrete" data-bs-whatever="mdo">Adicionar lembrete</button>
        }
    }
</ul>



<div class="modal fade" id="modelDialogAdicionarLembrete" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Lembrete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="mb-3">
                        <label for="message-text" class="col-form-label">Lembrete</label>
                        <input class="form-control" id="txtLembrete" type="text" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" onclick="AdicionarLembrete();">Concluir</button>
                <button id="btnFecharModalLembrete" type="button" class="btn btn-danger" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

